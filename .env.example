# Supabase Postgres — pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"

# Supabase Postgres — direct connection (used by Prisma migrate / db push)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase project URL
SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase service role key (server-side only — keep secret)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Supabase Storage bucket name
SUPABASE_STORAGE_BUCKET="imaging-studies"

# Port the API server listens on
PORT=3000

# Base URL of the frontend app (used for CORS / links)
FRONTEND_URL="http://localhost:4000"
