generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  scheduled
  checked_in
  completed
  cancelled

  @@map("appointment_status")
}

model Doctor {
  id   String @id @default(uuid()) @db.Uuid
  name String

  appointments Appointment[]

  @@map("doctors")
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  patientName     String            @map("patient_name")
  doctorId        String            @map("doctor_id") @db.Uuid
  startsAt        DateTime          @map("starts_at")
  endsAt          DateTime          @map("ends_at")
  status          AppointmentStatus @default(scheduled)
  reason          String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  doctor         Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  imagingStudies ImagingStudy[]

  @@index([doctorId])
  @@index([startsAt])
  @@index([doctorId, startsAt, endsAt])
  @@map("appointments")
}

/// Records one client-supplied Idempotency-Key per logical POST action so a
/// retried request replays the original response instead of creating a duplicate.
model IdempotencyKey {
  key          String   @id
  method       String
  path         String
  requestHash  String   @map("request_hash")
  status       String   @default("processing")
  statusCode   Int?     @map("status_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("idempotency_keys")
}

model ImagingStudy {
  id            String  @id @default(uuid()) @db.Uuid
  appointmentId String  @map("appointment_id") @db.Uuid
  modality      String
  description   String?
  dicomFilePath String  @map("dicom_file_path")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("imaging_studies")
}
